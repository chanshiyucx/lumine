source_path = "/absolute/path/to/photos"
target_path = "/absolute/path/to/output"
originals_dir = "gallery"
thumbnails_dir = "thumbnails"
thumbnail_width = 600
thumbnail_format = "webp"
thumbnail_quality = 92
avif_quality = 95
avif_speed = 6

# Use [] to publish every photo that has no private tag.
[public]
dir = "public"
tags = ["Public"]

# Private photos always win over public tags.
[private]
dir = "private"
tags = ["Private"]
