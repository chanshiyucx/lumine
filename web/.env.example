MEDIA_BASE_URL=https://cloud.example.com/public/

# Private mode is enabled only when all five are set.
# The password visitors type on /private.
PRIVATE_ACCESS_PASSWORD=
# Random secret for the session cookie, e.g. `openssl rand -base64 32`.
PRIVATE_SESSION_SECRET=
# The private media Worker; MEDIA_SIGNING_SECRET and PRIVATE_MANIFEST_TOKEN must match its secrets.
PRIVATE_MEDIA_ORIGIN=https://private.example.com
MEDIA_SIGNING_SECRET=
PRIVATE_MANIFEST_TOKEN=
